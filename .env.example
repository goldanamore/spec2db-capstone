# Spec2DB Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control -- it contains your real API key.

# Required: your Google Gemini API key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-2.5-flash)
# Change this only if the default model is unavailable or you prefer another.
# Examples: gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL=
